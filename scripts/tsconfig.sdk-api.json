{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "anchor/src/*": ["../node_modules/@glamsystems/glam-sdk/src/*"]
    }
  },
  "include": ["../src/**/*.ts"]
}
